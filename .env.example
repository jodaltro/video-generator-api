# Environment variables for Video Generator API (LTX-2)

# API Configuration
PORT=8000
HOST=0.0.0.0

# Model Configuration - LTX-2
MODELS_DIR=/workspace/models

# LTX-2 checkpoint (choose one):
#   ltx-2-19b-distilled-fp8.safetensors (fastest, lower memory)
#   ltx-2-19b-distilled.safetensors
#   ltx-2-19b-dev-fp8.safetensors
#   ltx-2-19b-dev.safetensors
LTX2_CHECKPOINT=ltx-2-19b-distilled-fp8.safetensors

# Spatial upscaler (required for two-stage pipelines)
LTX2_SPATIAL_UPSCALER=ltx-2-spatial-upscaler-x2-1.0.safetensors

# Distilled LoRA
LTX2_DISTILLED_LORA=ltx-2-19b-distilled-lora-384.safetensors

# Gemma text encoder directory name
GEMMA_DIR=gemma-3-12b-it-qat-q4_0-unquantized

# Performance Settings
ENABLE_FP8=true
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Default Generation Parameters
DEFAULT_FPS=25
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=768
DEFAULT_NUM_FRAMES=121
DEFAULT_NUM_INFERENCE_STEPS=40
DEFAULT_GUIDANCE_SCALE=3.0
