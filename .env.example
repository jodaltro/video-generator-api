# Environment variables for Video Generator API (Wan2.1)

# API Configuration
PORT=8000
HOST=0.0.0.0

# Model Configuration - Wan2.1-T2V-1.3B
MODELS_DIR=/workspace/models

# HuggingFace model ID (no token required - public model)
HF_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

# Performance Settings
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Default Generation Parameters
DEFAULT_FPS=16
DEFAULT_WIDTH=480
DEFAULT_HEIGHT=320
DEFAULT_NUM_FRAMES=33
DEFAULT_NUM_INFERENCE_STEPS=25
DEFAULT_GUIDANCE_SCALE=5.0
